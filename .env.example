# =============================================================================
# PurrfectReqs — Variabile de Mediu pentru Dezvoltare
# Acest fișier NU se commitează niciodată în git.
# =============================================================================

# Baza de date
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@db:5432/NUME_DB
POSTGRES_USER=USERNAME
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=NUME_DB

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=CHEIA_SECRETA_AICI
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b-instruct-v0.3-q4_K_M
OLLAMA_TIMEOUT_SECONDS=60
HSA_OVERRIDE_GFX_VERSION=10.3.0
ROCR_VISIBLE_DEVICES=0

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Aplicație
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info

# Încărcare fișiere
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=.txt,.md,.docx,.doc
